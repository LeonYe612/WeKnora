# WeKnora 二开 dev 容器：与生产 app 镜像同基础镜像（golang:1.26-bookworm），
# 只补 CGO 工具链 + air 热重载，不编译 anydoc(Rust) —— office 解析走生产 docreader。
# 基础镜像走 daocloud 镜像源：本机直连 docker.io 认证被阻断（auth.docker.io 超时）。
FROM docker.m.daocloud.io/library/golang:1.26-bookworm

ARG APT_MIRROR=mirrors.tencent.com

RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s@deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git build-essential libsqlite3-dev pkg-config \
        ca-certificates curl tzdata less procps && \
    rm -rf /var/lib/apt/lists/*

ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=off \
    GOFLAGS=-buildvcs=false \
    CGO_ENABLED=1 \
    TZ=Asia/Shanghai

RUN go install github.com/air-verse/air@latest

WORKDIR /app

# go.mod 对 third_party/anydoc-go 有 replace，必须先有该 module 的 go.mod。
# 注意：这里不能用 --mount=type=cache（cache mount 不进镜像层），否则运行时
# named volume 首次创建时无法从镜像继承模块，每次重建容器都要重新 go mod download。
COPY go.mod go.sum ./
COPY third_party/anydoc-go/go.mod third_party/anydoc-go/go.mod
RUN go mod download

CMD ["air", "-c", "deploy/devstack/.air.toml"]
